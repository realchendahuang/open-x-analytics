{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "tabWidth": 2,
  "trailingComma": "all",
  "printWidth": 100,
  "sortImports": {
    "newlinesBetween": false
  },
  "sortTailwindcss": {
    "stylesheet": "./src/index.css",
    "functions": ["cn", "cva", "clsx"]
  },
  "ignorePatterns": ["dist/**", "public/data/**", "README.md", "pnpm-lock.yaml"]
}
