{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsrs -b --noEmit --fast && vite build",
    "preview": "vite preview",
    "typecheck": "tsrs -b --noEmit --fast",
    "typecheck:strict": "tsrs -b --noEmit",
    "typecheck:tsc": "tsc -b",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check": "pnpm typecheck && pnpm lint && pnpm fmt:check"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "lucide-react": "^1.55.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "tailwindcss": "^4.3.3",
    "tsrs": "7.1.0-beta.tsrs4",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
